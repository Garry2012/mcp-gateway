# Deployment profile: healthcare-rg (shared with the front-desk and voice platforms).
#
#   DEPLOY_PROFILE=profiles/healthcare-rg.env ./deploy.sh
#
# Reuses the resource group's registry, Container Apps environment, Key Vault and
# Postgres server. The gateway gets its own managed identity, database and login
# role. No secret values belong in this file.

RESOURCE_GROUP=healthcare-rg
LOCATION=centralindia

ACR_NAME=acrfd399536
CAE_NAME=cae-frontdesk-demo-hospital
KEYVAULT_NAME=kv-fd-demo-hospi-0574c1

# Dedicated identity: the front-desk identity can read every secret in the shared vault.
UAMI_NAME=id-mcp-gateway

# Shared Burstable B1ms server: max_connections=50 across all applications.
PG_SERVER=pg-fd-demo-hospital-0574c1
PG_DATABASE=mcpgateway
PG_APP_USER=mcpgateway_app
PG_ADMIN_URL_SECRET=db-owner-url  # pragma: allowlist secret

# LLM Chat requires one worker until Redis shares its session configuration.
# Connection budget: GUNICORN_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) = 10.
GUNICORN_WORKERS=1
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=4

APP_NAME_AZ=mcp-gateway
IMAGE_REPO=mcp-gateway
APP_CPU=1.0
APP_MEMORY=2.0Gi
APP_MIN_REPLICAS=1
APP_MAX_REPLICAS=1

PLATFORM_ADMIN_EMAIL=admin@intimetec.com
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true

# Without Redis activity tracking, idle checks fall back to the token issuance time.
TOKEN_EXPIRY=480
TOKEN_IDLE_TIMEOUT=480

# Upstream servers retain legacy handshakes; inbound clients can use either protocol era.
MCP_CLIENT_CONNECT_MODE=legacy
MCP_INBOUND_PROTOCOL_MODE=auto

# The front-desk healthcare MCP server reads trusted call context from headers
# forwarded by the voice platform (allowlisted per gateway registration).
ENABLE_HEADER_PASSTHROUGH=true

# Keep exported traces in Langfuse without duplicate database trace recording.
OBSERVABILITY_ENABLED=false

# Langfuse Cloud EU; exporter authentication comes from Key Vault.
OTEL_ENABLE_OBSERVABILITY=true
OTEL_HTTPX_INSTRUMENTATION_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_EXPORTER_OTLP_INSECURE=false
KV_OTEL_HEADERS=mcpgw-langfuse-eu-otel-headers
OTEL_EMIT_LANGFUSE_ATTRIBUTES=true
OTEL_CAPTURE_IDENTITY_ATTRIBUTES=false
